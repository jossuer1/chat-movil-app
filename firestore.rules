rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(roomId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/chatRooms/$(roomId)).data.memberUids;
    }
    match /chatRooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberUids;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if member(roomId);
        allow create: if false;
        allow update: if member(roomId) && (
          (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 4000
            && request.resource.data.editedAt == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions is map && request.resource.data.reactions.size() <= 100
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.reactions)
              || request.resource.data.reactions[request.auth.uid] in ['👍','❤️','😂','🎉']))
        );
        allow delete: if false;
      }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
